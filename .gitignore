# Working data is never versioned: event logs, caches, feature tables, predictions,
# label files and anything pulled from an agency system.
data/
archive/
review/
.tmp/
*.parquet
*.duckdb
*.duckdb.wal
*.pth
*.pbix
*.csv
__pycache__/
.ipynb_checkpoints/
.venv/

# --- and so are the research charts ---
!research/charts/
!research/charts/**

# third-party document, kept locally for reference, not redistributed
research/notes/*.pdf

# agency-specific download code: never committed
research/code/download/

# --- pip package (atspm-detector) ---
# the package's bundled sample and reference answers ARE versioned
# (the folder itself must be re-included: the generic data/ rule above ignores every folder named data)
!src/atspm_detector/data/
!src/atspm_detector/data/*.parquet
!src/atspm_detector/reference/*.parquet
# build output
dist/
build/
*.egg-info/
.pytest_cache/
